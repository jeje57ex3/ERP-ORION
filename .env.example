# ============================================================
# Orion ERP — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ============================================================

# Environnement : development | production | testing
DJANGO_SETTINGS_MODULE=erp_btp.settings.development

# Clé secrète Django — CHANGER EN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Debug
DEBUG=True

# Hôtes autorisés (séparés par virgule)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF (production uniquement, séparés par virgule)
CSRF_TRUSTED_ORIGINS=https://mondomaine.fr

# CORS (séparés par virgule)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Base de données centrale ─────────────────────────────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_NAME=orion_core
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@orion-erp.local

# ─── Répertoires ─────────────────────────────────────────────────────────────
BACKUP_DIR=backups
LOG_DIR=logs
