# ============================================================
# Orion ERP — Variables d'environnement
# Copier ce fichier en .env et renseigner toutes les valeurs
# NE JAMAIS committer le fichier .env réel
# ============================================================

# Environnement : development | production | testing
DJANGO_SETTINGS_MODULE=erp_btp.settings.development

# Clé secrète Django — OBLIGATOIRE, changer en production
SECRET_KEY=change-me-in-production-use-a-long-random-string-50-chars-minimum

# Debug — mettre False en production
DEBUG=True

# Hôtes autorisés (séparés par virgule)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF (production uniquement, séparés par virgule)
CSRF_TRUSTED_ORIGINS=https://mondomaine.fr

# CORS (séparés par virgule)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Base de données centrale ─────────────────────────────────────────────────
DATABASE_URL=mysql://root:motdepasse@127.0.0.1:3306/orion_core
# Ou paramètres séparés :
DB_ENGINE=django.db.backends.mysql
DB_NAME=orion_core
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Cache / Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@orion-erp.local

# ─── Stripe (paiements) ───────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_REMPLACER
STRIPE_SECRET_KEY=sk_test_REMPLACER
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER
# Clés live — uniquement en production sécurisée
# STRIPE_PUBLIC_KEY=pk_live_REMPLACER
# STRIPE_SECRET_KEY=sk_live_REMPLACER
# STRIPE_WEBHOOK_SECRET=whsec_REMPLACER

# ─── Orion AI ─────────────────────────────────────────────────────────────────
ORION_AI_ENABLED=False
ORION_AI_PROVIDER=openai
ORION_AI_API_KEY=sk-proj-REMPLACER
ORION_AI_MODEL=gpt-4o-mini
ORION_AI_MAX_TOKENS=2048

# ─── Haute disponibilité / Réplication ────────────────────────────────────────
HA_ENABLED=False
HA_PRIMARY_HOST=127.0.0.1
HA_REPLICA_HOST=
HA_SYNC_INTERVAL=300

# ─── Sites boutiques publiques ────────────────────────────────────────────────
SIECLE_STORE_URL=https://siecle-creations.fr
LUNEA_STORE_URL=https://lunea-beauty.fr
SIECLE_STORE_DOMAIN=siecle-creations.fr
LUNEA_STORE_DOMAIN=lunea-beauty.fr

# ─── Orion ERP interne ────────────────────────────────────────────────────────
ORION_ADMIN_URL=orion-admin/
ORION_PROJECT_ROOT=
ORION_GIT_REMOTE=origin
ORION_GIT_BRANCH=main

# ─── Stockage / Répertoires ───────────────────────────────────────────────────
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/
BACKUP_DIR=backups/
LOG_DIR=logs/

# ─── Sécurité production ──────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
