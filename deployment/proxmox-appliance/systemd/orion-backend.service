[Unit]
Description=Orion ERP — Backend Django (login.elysiums.fr — port 9000)
After=network-online.target orion-db-stack.service
Wants=network-online.target
Requires=orion-db-stack.service

# ─── Borne de redemarrage ───────────────────────────────────────────────────
#
# SANS ELLE, LA BOUCLE EST INFINIE, et ce n'est pas une hypothese : le
# 09/11/2026, lunea-frontend affichait « restart counter is at 578 » et
# siecle-frontend 177, sur une appliance ou ils ne pouvaient pas demarrer.
#
# Le defaut de systemd (cinq essais dans une fenetre de DIX secondes) ne
# protege de rien ici : avec RestartSec a 5 ou 10 secondes, deux essais au
# plus tombent dans la fenetre, le seuil n'est jamais atteint, et le service
# se relance jusqu'a la fin des temps. Une fenetre plus LARGE est ce qui
# borne reellement la boucle.
#
# Vingt essais sur dix minutes : le service insiste assez longtemps pour
# traverser une base lente a demarrer ou une coupure passagere, puis
# renonce et se marque EN ECHEC -- un etat visible, qui ne consomme
# plus la machine et que « systemctl --state=failed » nomme.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=orion
Group=orion
WorkingDirectory=/opt/orion/backend
EnvironmentFile=/opt/orion/backend/.env
Environment=DJANGO_SETTINGS_MODULE=erp_btp.settings.production
# Prefixe « - » : un echec de ce script ne doit PAS empecher le demarrage.
# Son role est de rafraichir ALLOWED_HOSTS, pas de garder la porte. Sans ce
# prefixe, un simple bug dedans rendait orion-backend indemarrable et nginx
# repondait 502 — c est arrive, pour une cle absente du .env. Le controle
# des ports, lui, reste bloquant : attendre MySQL est un vrai prerequis.
ExecStartPre=-/opt/orion/scripts/refresh_allowed_hosts.sh
ExecStartPre=/opt/orion/scripts/wait_for_port.sh 127.0.0.1 3306 60
ExecStartPre=/opt/orion/scripts/wait_for_port.sh 127.0.0.1 6379 60
ExecStart=/opt/orion/backend/.venv/bin/gunicorn erp_btp.wsgi:application \
    --bind 127.0.0.1:9000 \
    --workers 3 \
    --timeout 600 \
    --access-logfile /opt/orion/logs/gunicorn-backend-access.log \
    --error-logfile /opt/orion/logs/gunicorn-backend-error.log
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
