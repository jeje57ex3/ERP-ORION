[Unit]
Description=Orion ERP — Assistant de premier démarrage (console)
# Pas de After=cloud-final.service ici : ce service est WantedBy=multi-user.target,
# et cloud-final.service est lui-même ordonné Before=multi-user.target — les deux
# combinés créent un cycle de dépendances que systemd ne peut pas casser sur les
# boots suivant le tout premier (« Unable to break cycle »), bloquant définitivement
# le démarrage du service. L'ordre par rapport à cloud-final n'est de toute façon pas
# nécessaire : au premier boot, runcmd déclenche déjà ce service explicitement APRÈS
# la fin du Stage A (ordre séquentiel du runcmd) ; sur les boots suivants,
# ConditionPathExists garantit à lui seul que le Stage A a déjà eu lieu.
After=network-online.target orion-db-stack.service
Wants=network-online.target orion-db-stack.service
Conflicts=serial-getty@ttyS0.service
ConditionPathExists=/opt/orion/.awaiting-setup

[Service]
Type=oneshot
ExecStart=/opt/orion/scripts/first-boot-wizard.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
