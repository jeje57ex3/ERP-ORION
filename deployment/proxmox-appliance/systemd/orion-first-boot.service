[Unit]
Description=Orion ERP — Assistant de premier démarrage (console)
After=cloud-final.service network-online.target orion-db-stack.service
Wants=network-online.target orion-db-stack.service
Conflicts=getty@tty1.service
ConditionPathExists=/opt/orion/.awaiting-setup

[Service]
Type=oneshot
ExecStart=/opt/orion/scripts/first-boot-wizard.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
