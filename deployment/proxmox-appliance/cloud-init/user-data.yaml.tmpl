#cloud-config
# Orion ERP Appliance — cloud-init Stage A (automatique, non interactif)
# Généré par lib/20-build-cloud-init-seed.sh — ne pas éditer le résultat rendu à la main.

hostname: orion-erp
manage_etc_hosts: true
package_update: true
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true

ssh_pwauth: false

users:
  - default
  - name: orion
    gecos: "Orion ERP Appliance"
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    __ORION_SSH_KEYS_BLOCK__

write_files:
  - path: /opt/orion-appliance/payload.tar.gz
    encoding: b64
    permissions: '0600'
    owner: root:root
    content: |
__PAYLOAD_B64__

  - path: /opt/orion-appliance/build-info.env
    permissions: '0644'
    owner: root:root
    content: |
      ORION_APPLIANCE_VERSION=__ORION_VERSION__
      ORION_APPLIANCE_BUILD_DATE=__BUILD_DATE__
      ORION_GIT_REPO_URL=__ORION_GIT_REPO_URL__
      ORION_GIT_BRANCH=__ORION_GIT_BRANCH__

  # Valeurs propres à CE déploiement (domaines, token Cloudflare) — laissées
  # en placeholders ici : le rendu de build.sh (mis en cache entre
  # déploiements) ne les connaît pas. import_proxmox.sh fait une 2e passe de
  # rendu, par-dessus la copie snippet déjà scopée par VMID, avec les
  # vraies valeurs saisies pour cette VM précise.
  - path: /opt/orion-appliance/deploy-info.env
    permissions: '0600'
    owner: root:root
    content: |
      LOGIN_DOMAIN=__LOGIN_DOMAIN__
      ORION_DOMAIN=__ORION_DOMAIN__
      SIECLE_DOMAIN=__SIECLE_DOMAIN__
      LUNEA_DOMAIN=__LUNEA_DOMAIN__
      NS_DOMAIN=__NS_DOMAIN__
      NODE_DOMAIN=__NODE_DOMAIN__
      CF_TUNNEL_TOKEN=__CF_TUNNEL_TOKEN__
      GITHUB_TOKEN=__GITHUB_TOKEN__

runcmd:
  - [ mkdir, -p, /opt/orion-appliance ]
  - [ bash, -c, "tar xzf /opt/orion-appliance/payload.tar.gz -C /opt/orion-appliance" ]
  # UNE seule ligne : tout le provisioning est orchestré par
  # provisioning/00-provisionner.sh. Auparavant, chaque étape avait sa ligne
  # ici, avec son propre « set -a; . build-info.env; . deploy-info.env » —
  # c'est-à-dire que ces fichiers étaient EXÉCUTÉS, et l'ordre réel des étapes
  # (07 avant 03) ne tenait qu'à un commentaire YAML. Trois pannes en sont
  # venues ; voir l'en-tête de 00-provisionner.sh.
  #
  # « bash <chemin> » et non le chemin seul : un script arrivé en 100644
  # (git conserve le mode) échouerait en « command not found ».
  - [ bash, -c, "bash /opt/orion-appliance/provisioning/00-provisionner.sh" ]

# Volontairement sobre : l'état réel de l'installation est écrit dans
# /etc/motd par 00-provisionner.sh, d'après ce qu'il a vérifié. Annoncer
# « prête » sans l'avoir vérifié envoie l'exploitant chercher la panne dans
# son navigateur, à plusieurs étapes de sa cause — c'est ce qui s'est produit.
final_message: "Orion ERP — provisioning terminé. Connectez-vous à la console de la VM : le message d'accueil indique l'état de l'installation et, le cas échéant, ce qui a échoué."
