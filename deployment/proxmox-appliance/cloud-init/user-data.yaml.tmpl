#cloud-config
# Orion ERP Appliance — cloud-init Stage A (automatique, non interactif)
# Généré par lib/20-build-cloud-init-seed.sh — ne pas éditer le résultat rendu à la main.

hostname: orion-erp
manage_etc_hosts: true
package_update: true
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true

ssh_pwauth: false

users:
  - default
  - name: orion
    gecos: "Orion ERP Appliance"
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    __ORION_SSH_KEYS_BLOCK__

write_files:
  - path: /opt/orion-appliance/payload.tar.gz
    encoding: b64
    permissions: '0600'
    owner: root:root
    content: |
__PAYLOAD_B64__

  - path: /opt/orion-appliance/build-info.env
    permissions: '0644'
    owner: root:root
    content: |
      ORION_APPLIANCE_VERSION=__ORION_VERSION__
      ORION_APPLIANCE_BUILD_DATE=__BUILD_DATE__
      ORION_GIT_REPO_URL=__ORION_GIT_REPO_URL__
      ORION_GIT_BRANCH=__ORION_GIT_BRANCH__

  # Valeurs propres à CE déploiement (domaines, token Cloudflare) — laissées
  # en placeholders ici : le rendu de build.sh (mis en cache entre
  # déploiements) ne les connaît pas. import_proxmox.sh fait une 2e passe de
  # rendu, par-dessus la copie snippet déjà scopée par VMID, avec les
  # vraies valeurs saisies pour cette VM précise.
  - path: /opt/orion-appliance/deploy-info.env
    permissions: '0600'
    owner: root:root
    content: |
      LOGIN_DOMAIN=__LOGIN_DOMAIN__
      ORION_DOMAIN=__ORION_DOMAIN__
      SIECLE_DOMAIN=__SIECLE_DOMAIN__
      LUNEA_DOMAIN=__LUNEA_DOMAIN__
      CF_TUNNEL_TOKEN=__CF_TUNNEL_TOKEN__
      GITHUB_TOKEN=__GITHUB_TOKEN__

runcmd:
  - [ mkdir, -p, /opt/orion-appliance ]
  - [ bash, -c, "tar xzf /opt/orion-appliance/payload.tar.gz -C /opt/orion-appliance" ]
  - [ bash, -c, "chmod +x /opt/orion-appliance/provisioning/*.sh /opt/orion-appliance/scripts/*.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/build-info.env; set +a; /opt/orion-appliance/provisioning/01-system-packages.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/build-info.env; . /opt/orion-appliance/deploy-info.env; set +a; /opt/orion-appliance/provisioning/02-deploy-orion.sh" ]
  # 07 avant 03 : /opt/orion/scripts/wait_for_port.sh (utilisé par les
  # ExecStartPre des services orion-backend/orion-frontend) doit exister
  # avant que 03 ne démarre ces services.
  - [ bash, -c, "/opt/orion-appliance/provisioning/07-backup-cron.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/deploy-info.env; set +a; /opt/orion-appliance/provisioning/03-systemd-units.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/deploy-info.env; set +a; /opt/orion-appliance/provisioning/04-nginx-config.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/deploy-info.env; set +a; /opt/orion-appliance/provisioning/05-cloudflared-config.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/06-ufw-fail2ban.sh" ]
  - [ bash, -c, "echo 'Orion ERP Appliance — provisioning terminé. Rendez-vous sur https://<votre-domaine>/ (ou l’IP de la VM) pour créer votre compte administrateur.' > /etc/motd" ]

final_message: "Orion ERP Appliance prête — ouvrez votre navigateur sur le domaine (ou l'IP) de la VM pour créer votre compte administrateur."
