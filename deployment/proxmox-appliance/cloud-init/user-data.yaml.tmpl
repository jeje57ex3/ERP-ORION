#cloud-config
# Orion ERP Appliance — cloud-init Stage A (automatique, non interactif)
# Généré par lib/20-build-cloud-init-seed.sh — ne pas éditer le résultat rendu à la main.

hostname: orion-erp
manage_etc_hosts: true
package_update: true
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true

ssh_pwauth: false

users:
  - default
  - name: orion
    gecos: "Orion ERP Appliance"
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
    # Clé(s) publique(s) SSH : injectées par Proxmox via --sshkeys au moment de
    # l'import (voir import_proxmox.sh / PROXMOX.md), ou à ajouter ici avant build.

write_files:
  - path: /opt/orion-appliance/payload.tar.gz.b64
    encoding: b64
    permissions: '0600'
    owner: root:root
    content: __PAYLOAD_B64__

  - path: /opt/orion-appliance/build-info.env
    permissions: '0644'
    owner: root:root
    content: |
      ORION_APPLIANCE_VERSION=__ORION_VERSION__
      ORION_APPLIANCE_BUILD_DATE=__BUILD_DATE__
      ORION_GIT_REPO_URL=__ORION_GIT_REPO_URL__
      ORION_GIT_BRANCH=__ORION_GIT_BRANCH__

runcmd:
  - [ mkdir, -p, /opt/orion-appliance ]
  - [ bash, -c, "base64 -d /opt/orion-appliance/payload.tar.gz.b64 > /opt/orion-appliance/payload.tar.gz" ]
  - [ bash, -c, "tar xzf /opt/orion-appliance/payload.tar.gz -C /opt/orion-appliance" ]
  - [ bash, -c, "chmod +x /opt/orion-appliance/provisioning/*.sh /opt/orion-appliance/scripts/*.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/build-info.env; set +a; /opt/orion-appliance/provisioning/01-system-packages.sh" ]
  - [ bash, -c, "set -a; . /opt/orion-appliance/build-info.env; set +a; /opt/orion-appliance/provisioning/02-deploy-orion.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/03-systemd-units.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/04-nginx-config.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/05-cloudflared-config.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/06-ufw-fail2ban.sh" ]
  - [ bash, -c, "/opt/orion-appliance/provisioning/07-backup-cron.sh" ]
  - [ touch, /opt/orion/.awaiting-setup ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, orion-first-boot.service ]
  - [ bash, -c, "echo 'Orion ERP Appliance — provisioning Stage A terminé.' > /etc/motd" ]

final_message: "Orion ERP Appliance prête — l'assistant de premier démarrage se lance sur la console (tty1)."
