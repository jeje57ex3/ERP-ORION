# ─── ns.elysiums.fr → site NÉOSTRUCTURA (SPA statique + API Django) ────────────
# Servi par Nginx lui-même, et non par un service `serve` dédié comme SIÈCLE et
# LUNEA : le client API de ce site appelle des chemins RELATIFS (/api/v1/...,
# /media/...). En développement c'est le proxy du serveur Vite qui les renvoie
# vers Django (frontend/neostructura-site/vite.config.js) ; en production il
# faut donc que le SPA et l'API partagent la même origine, ce qu'un simple
# serveur de fichiers statiques ne sait pas faire.
#
# Consequence importante : pour CE domaine, l'ingress du tunnel Cloudflare doit
# viser Nginx (http://127.0.0.1:80) et non un port applicatif direct, sinon les
# appels /api ne seraient jamais proxifies.
server {
    listen 80;
    server_name __NS_DOMAIN__;

    access_log /var/log/nginx/orion_ns_access.log;
    error_log  /var/log/nginx/orion_ns_error.log warn;

    root /opt/orion/neostructura;
    index index.html;

    # Routage cote client (React Router) : toute URL inconnue rend index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
