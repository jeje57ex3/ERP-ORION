# Orion ERP Appliance — vhosts Nginx (accès direct/LAN + Certbot).
# Le tunnel Cloudflare cible directement les ports 127.0.0.1:9000/5172/5173/5174
# (voir cloudflared config.yml) — Nginx sert l'accès local/HTTPS classique.
# Placeholders __*__ substitués par 04-nginx-config.sh avec les domaines
# fournis au déploiement (deploy.sh -> deploy-info.env).

# ─── login.elysiums.fr → 9000 (ERP / admin) ────────────────────────────────────
# default_server : permet d'atteindre l'assistant de premier accès (/setup/)
# en visitant directement l'IP de la VM, avant même qu'un domaine ne pointe
# dessus.
server {
    listen 80 default_server;
    server_name __LOGIN_DOMAIN__;

    access_log /var/log/nginx/orion_login_access.log;
    error_log  /var/log/nginx/orion_login_error.log warn;

    # Export/import de sauvegardes portables (apps/backups) : base + médias
    # dans une seule archive, potentiellement volumineuse (plusieurs centaines
    # de Mo) — la limite nginx par défaut (1M) rejetterait l'upload.
    client_max_body_size 2G;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # Quand gunicorn ne repond pas -- redemarrage du serveur, du
        # service, ou mise a jour qui le relance -- nginx est la SEULE
        # chose encore debout. Sans cette page, l'utilisateur recoit le
        # « 502 Bad Gateway » brut : un message technique qui laisse croire
        # a une panne et pousse a appeler l'administrateur en pleine
        # operation.
        #
        # Django a sa propre page de maintenance (503), servie quand il
        # tourne encore ; celle-ci couvre le seul cas qu'il ne peut pas
        # couvrir lui-meme : son absence.
        error_page 502 503 504 /__redemarrage.html;
    }

    # internal : inatteignable depuis l'extérieur, seulement par
    # error_page. Sans cela, l'adresse serait publique et l'on pourrait
    # afficher « redemarrage en cours » sur un serveur en parfait etat.
    location = /__redemarrage.html {
        internal;
        root /opt/orion/nginx;
        try_files /redemarrage.html =502;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
    }
}

# ─── orion.elysiums.fr → 5172 (Vitrine) ────────────────────────────────────────
server {
    listen 80;
    server_name __ORION_DOMAIN__;

    access_log /var/log/nginx/orion_frontend_access.log;
    error_log  /var/log/nginx/orion_frontend_error.log warn;

    location / {
        proxy_pass http://127.0.0.1:5172;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

