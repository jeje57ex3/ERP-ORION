# ============================================================
# Orion ERP Appliance — Configuration
# ============================================================

DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_LONG_SECRET_KEY_50_CHARS_MIN
ALLOWED_HOSTS=localhost,127.0.0.1,erp.example.com
CSRF_TRUSTED_ORIGINS=http://localhost,https://erp.example.com

ORION_ENV=production
ORION_APPLIANCE_MODE=True

# Domaine public
ORION_PUBLIC_URL=https://erp.example.com
ORION_PRIMARY_DOMAIN=erp.example.com

# Ports
HTTP_PORT=80
HTTPS_PORT=443

# ─── Base de données MySQL ─────────────────────────────────────────────────────
MYSQL_DATABASE=orion
MYSQL_USER=orion
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=orion
DATABASE_USER=orion
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_HOST=orion-db
DATABASE_PORT=3306

# ─── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://orion-redis:6379/0
CELERY_BROKER_URL=redis://orion-redis:6379/1
CELERY_RESULT_BACKEND=redis://orion-redis:6379/2

# ─── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
DEFAULT_FROM_EMAIL=Orion ERP <contact@example.com>

# ─── Stripe (global fallback) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Chiffrement secrets boutique (Fernet) ─────────────────────────────────────
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORION_SECRET_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# ─── Super Admin initial ───────────────────────────────────────────────────────
ORION_SUPERADMIN_EMAIL=admin@example.com
ORION_SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ─── Sauvegardes ───────────────────────────────────────────────────────────────
ORION_BACKUP_DIR=/app/backups
ORION_BACKUP_RETENTION_DAYS=14

# ─── Haute disponibilité ───────────────────────────────────────────────────────
ORION_HA_ENABLED=False
ORION_NODE_ID=orion-primary
ORION_NODE_ROLE=primary
ORION_NODE_PRIORITY=1
ORION_HA_SECRET=CHANGE_ME_HA_SECRET

# ─── Mises à jour ──────────────────────────────────────────────────────────────
ORION_UPDATES_ENABLED=True
ORION_UPDATE_MODE=manual
ORION_GIT_REMOTE=origin
ORION_GIT_BRANCH=main

# ─── Celery restart hooks (optionnel, Docker gère le restart) ──────────────────
ORION_UPDATE_CELERY_RESTART_COMMAND=docker compose restart orion-celery
ORION_UPDATE_CELERY_BEAT_RESTART_COMMAND=docker compose restart orion-celery-beat
