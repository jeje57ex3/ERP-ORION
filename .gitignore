# Env & secrets — NE JAMAIS committer les vraies valeurs
.env
.env.local
.env.production
.env.staging
.env.*
!.env.example

# Python
*.pyc
*.pyo
__pycache__/
*.pycache/
.pytest_cache/

# DB
db.sqlite3
db_local.sqlite3
*.db

# Sorties de build des frontends (reconstruites au deploiement)
frontend/*/dist/
static/neostructura-site/

# Generated / large assets
media/
staticfiles/
storage/

# Exports de donnees (export_orion_data.ps1) : dumps et medias reels,
# ne doivent jamais etre versionnes.
/build/
orion-data-*.tar.gz
orion-data-*.tar.gz.sha256
database.sql

# Catalogues compiles : generes depuis les .po par compilemessages, au
# provisioning et a chaque mise a jour. Les versionner les laisserait
# silencieusement en retard sur leurs sources.
locale/*/LC_MESSAGES/*.mo

# Logs & backups
logs/
*.log
/backups/

# Virtual envs
venv/
.venv/
env/

# Node
node_modules/

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Sauvegarde de migration locale (donnees reelles, jamais en git)
/orion_migration_backup/

# Etat de reprise de l'exploration des catalogues fabricants : des listes
# d'URL deja visitees, propres a chaque machine et reconstructibles. Les
# versionner ferait des conflits a chaque execution.
var/
